# 로컬 개발 시 DB 연결 (Vercel에서 가져오기: vercel env pull .env.local)
# POSTGRES_URL=

# 채팅 푸시 알림용 VAPID 키 (다른 탭에서도 알림 수신)
# 생성: node -e "const w=require('web-push'); const v=w.generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY='+v.publicKey); console.log('VAPID_PRIVATE_KEY='+v.privateKey);"
# Vercel: 프로젝트 → Settings → Environment Variables 에서 추가
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
